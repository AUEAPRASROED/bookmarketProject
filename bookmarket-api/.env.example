# คัดลอกเป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ห้าม commit)
# Supabase Session pooler (port 5432) + ?sslmode=require ห้ามมีเครื่องหมายคำพูด
DATABASE_URL=postgresql://postgres.<project-ref>:<รหัส>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# วางผลลัพธ์ของ openssl rand -base64 48 (ไม่ใช่ตัวคำสั่ง)
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
